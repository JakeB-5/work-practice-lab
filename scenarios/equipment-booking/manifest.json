{
  "schemaVersion": "0.1.0",
  "scenarioId": "equipment-booking",
  "version": "0.1.3",
  "title": "촬영 장비 예약",
  "summary": "중복 예약과 취소 누락을 줄이는 작은 사내 예약 서비스를 만듭니다.",
  "durationSeconds": 9000,
  "publicBrief": "public/brief.md",
  "resources": [
    {
      "id": "equipment",
      "title": "장비 목록",
      "path": "public/resources/equipment.json",
      "mediaType": "application/json"
    },
    {
      "id": "access",
      "title": "테스트 로그인 안내",
      "path": "public/resources/access.md",
      "mediaType": "text/markdown"
    },
    {
      "id": "api-contract",
      "title": "제공 API 계약",
      "path": "public/resources/api-contract.md",
      "mediaType": "text/markdown"
    },
    {
      "id": "ai-contract",
      "title": "과제 앱 AI 연결 안내",
      "path": "public/resources/ai-contract.md",
      "mediaType": "text/markdown"
    }
  ],
  "starterDir": "public/starter",
  "prepare": [
    {
      "argv": [
        "node",
        "--check",
        "server.mjs"
      ],
      "cwdRelative": ".",
      "timeoutSeconds": 30,
      "environmentKeys": []
    }
  ],
  "run": {
    "argv": [
      "node",
      "server.mjs"
    ],
    "cwdRelative": ".",
    "timeoutSeconds": 30,
    "environmentKeys": [
      "WPL_SCENARIO_AI_URL",
      "WPL_SCENARIO_AI_TOKEN",
      "WPL_DATABASE_URL"
    ]
  },
  "validationProfile": "private/validation.json"
}
