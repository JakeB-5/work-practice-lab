{
  "schemaVersion": "0.1.0",
  "scenarioId": "retail-coaching",
  "version": "0.1.3",
  "title": "고객 응대 연습 도구",
  "summary": "신입 직원이 고객의 필요를 묻고, 추천 이유를 설명하는 연습을 돕습니다.",
  "durationSeconds": 7200,
  "publicBrief": "public/brief.md",
  "resources": [
    {
      "id": "catalog",
      "title": "가상 상품 자료",
      "path": "public/resources/catalog.json",
      "mediaType": "application/json"
    },
    {
      "id": "policy",
      "title": "교환·반품 안내",
      "path": "public/resources/policy.md",
      "mediaType": "text/markdown"
    },
    {
      "id": "training",
      "title": "교육 담당자 메모",
      "path": "public/resources/training.md",
      "mediaType": "text/markdown"
    },
    {
      "id": "ai-contract",
      "title": "과제 앱 AI 연결 안내",
      "path": "public/resources/ai-contract.md",
      "mediaType": "text/markdown"
    }
  ],
  "starterDir": "public/starter",
  "prepare": [
    {
      "argv": [
        "node",
        "--check",
        "server.mjs"
      ],
      "cwdRelative": ".",
      "timeoutSeconds": 30,
      "environmentKeys": []
    }
  ],
  "run": {
    "argv": [
      "node",
      "server.mjs"
    ],
    "cwdRelative": ".",
    "timeoutSeconds": 30,
    "environmentKeys": [
      "WPL_SCENARIO_AI_URL",
      "WPL_SCENARIO_AI_TOKEN",
      "WPL_DATABASE_URL"
    ]
  },
  "validationProfile": "private/validation.json"
}
