{
  "name": "work-practice-lab",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx watch apps/server/src/index.ts",
    "start": "tsx apps/server/src/index.ts",
    "build": "vite build && tsc --noEmit",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "tsx tools/e2e.ts",
    "test:live": "tsx tools/runtime-probe/live.ts",
    "tasks": "tsx tools/task-status.ts",
    "postinstall": "node tools/postinstall.mjs",
    "lab": "tsx tools/agent-cli.ts",
    "setup": "node tools/setup.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "cookie-parser": "^1.4.7",
    "ws": "^8.18.0",
    "node-pty": "^1.1.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.52.0",
    "@monaco-editor/react": "^4.7.0",
    "@xterm/xterm": "^5.5.0",
    "@xterm/addon-fit": "^0.10.0",
    "smol-toml": "^1.3.1",
    "pg": "^8.16.0",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "vite": "^7.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "vitest": "^3.2.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/express": "^5.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/ws": "^8.18.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/pg": "^8.15.0"
  }
}
